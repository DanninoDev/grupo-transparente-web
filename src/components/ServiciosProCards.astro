---
// ServiciosTransporte-v3.astro
---

<section class="bg-gradient-to-b from-white via-gray-50 to-white py-24 px-4">
  <div class="max-w-7xl mx-auto">

    <!-- Header Section -->
    <div class="max-w-3xl mb-20">
      <span
        class="reveal inline-block px-4 py-2 bg-[#0C245C]/10 text-[#0C245C] text-sm font-semibold rounded-full mb-6"
        style="--d: 0ms"
      >
        NUESTROS SERVICIOS
      </span>

      <!-- Typewriter Title -->
      <h1 class="text-5xl md:text-6xl font-bold text-[#0C245C] leading-tight mb-6">
        <span
          class="typewrap inline-block align-top"
          data-type-lines="Impulsa tu operación,|brinda un gran servicio"
        >
          <!-- línea 1 -->
          <span class="type-line block">
            <span class="type-text"></span><span class="caret" aria-hidden="true"></span>
          </span>
          <!-- línea 2 -->
          <span class="type-line block">
            <span class="type-text"></span><span class="caret" aria-hidden="true"></span>
          </span>
        </span>
      </h1>

      <p
        class="reveal text-xl text-gray-600 leading-relaxed"
        style="--d: 220ms"
      >
        Soluciones integrales para la profesionalización del transporte y la logística
      </p>
    </div>

    <!-- Main Content Layout -->
    <div class="grid lg:grid-cols-12 gap-12 items-start">

      <!-- Left Column - Core Concept -->
      <div class="lg:col-span-4">
        <div class="sticky top-8">
          <!-- Central Concept Card -->
          <div
            class="reveal bg-gradient-to-br from-[#0C245C] to-[#1e4a8f] rounded-3xl p-10 text-white shadow-2xl"
            style="--d: 120ms"
          >
            <div class="w-20 h-20 bg-white/20 backdrop-blur-sm rounded-2xl flex items-center justify-center mb-6">
              <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h2 class="text-3xl font-bold mb-4">Profesionalización del Transporte</h2>
            <p class="text-white/90 text-lg leading-relaxed mb-8">
              Nuestro enfoque integral transforma tu operación mediante la optimización de procesos y el fortalecimiento de la cultura organizacional.
            </p>

            <!-- Key Elements -->
            <div class="space-y-4">
              <div class="flex items-center gap-4 p-4 bg-white/10 backdrop-blur-sm rounded-xl">
                <div class="w-12 h-12 bg-white/20 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-lg">Procesos</h3>
                  <p class="text-white/80 text-sm">Optimización continua</p>
                </div>
              </div>

              <div class="flex items-center gap-4 p-4 bg-white/10 backdrop-blur-sm rounded-xl">
                <div class="w-12 h-12 bg-white/20 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-lg">Cultura</h3>
                  <p class="text-white/80 text-sm">Transformación organizacional</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Commitment Card -->
          <div
            class="reveal mt-6 bg-white rounded-2xl p-8 shadow-lg border border-gray-200"
            style="--d: 220ms"
          >
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-[#0C245C]/10 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-[#0C245C]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-[#0C245C] text-lg mb-2">Nuestro Compromiso</h3>
                <p class="text-gray-600 leading-relaxed">
                  Maximizar el potencial de nuestros clientes mediante soluciones simples pero reales.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column - Services Grid -->
      <div class="lg:col-span-8 space-y-6">

        <!-- Service 1 -->
        <div class="reveal bg-white rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-100 group" style="--d: 120ms">
          <div class="p-8">
            <div class="flex items-start gap-6">
              <div class="w-16 h-16 bg-gradient-to-br from-[#0C245C] to-[#1e4a8f] rounded-2xl flex items-center justify-center flex-shrink-0 shadow-lg group-hover:scale-110 transition-transform duration-300">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 0 014 0z" />
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-2xl font-bold text-[#0C245C] mb-3">Socios del Transporte</h3>
                <p class="text-gray-600 leading-relaxed text-lg">
                  <span class="font-semibold text-[#0C245C]">Conexión de transporte</span> para atender las cargas de nuestros clientes, con socios confiables pero con un servicio profesional — nuestra etiqueta <span class="italic font-semibold text-[#0C245C]">Transparente</span>.
                </p>
              </div>
            </div>
          </div>
          <div class="h-1 bg-gradient-to-r from-[#0C245C] to-transparent"></div>
        </div>

        <!-- Service 2 -->
        <div class="reveal bg-white rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-100 group" style="--d: 180ms">
          <div class="p-8">
            <div class="flex items-start gap-6">
              <div class="w-16 h-16 bg-gradient-to-br from-[#0C245C] to-[#1e4a8f] rounded-2xl flex items-center justify-center flex-shrink-0 shadow-lg group-hover:scale-110 transition-transform duration-300">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-2xl font-bold text-[#0C245C] mb-3">Consultoría en Logística y Transporte</h3>
                <p class="text-gray-600 leading-relaxed text-lg mb-4">
                  Un gran programa basado en volver a los básicos e impulso estratégico, creando soluciones a la medida con un objetivo claro:
                </p>
                <div class="flex flex-wrap gap-3">
                  <span class="px-4 py-2 bg-[#0C245C]/10 text-[#0C245C] rounded-lg font-semibold text-sm">Control</span>
                  <span class="px-4 py-2 bg-[#0C245C]/10 text-[#0C245C] rounded-lg font-semibold text-sm">Crecimiento</span>
                  <span class="px-4 py-2 bg-[#0C245C]/10 text-[#0C245C] rounded-lg font-semibold text-sm">Ingresos</span>
                  <span class="px-4 py-2 bg-[#0C245C]/10 text-[#0C245C] rounded-lg font-semibold text-sm">Servicio</span>
                </div>
              </div>
            </div>
          </div>
          <div class="h-1 bg-gradient-to-r from-[#0C245C] to-transparent"></div>
        </div>

        <!-- Service 3 -->
        <div class="reveal bg-white rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-100 group" style="--d: 240ms">
          <div class="p-8">
            <div class="flex items-start gap-6">
              <div class="w-16 h-16 bg-gradient-to-br from-[#0C245C] to-[#1e4a8f] rounded-2xl flex items-center justify-center flex-shrink-0 shadow-lg group-hover:scale-110 transition-transform duration-300">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-2xl font-bold text-[#0C245C] mb-3">Gemelo Logístico</h3>
                <p class="text-gray-600 leading-relaxed text-lg mb-6">
                  <span class="font-semibold text-[#0C245C]">Operamos tu empresa</span> con base en tus reglas de negocio, en los rubros:
                </p>
                <div class="grid sm:grid-cols-3 gap-4">
                  <div class="flex flex-col items-center text-center p-4 bg-gray-50 rounded-xl hover:bg-[#0C245C]/5 transition-colors">
                    <div class="w-12 h-12 bg-[#0C245C] rounded-xl flex items-center justify-center mb-3">
                      <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                    </div>
                    <span class="font-semibold text-[#0C245C]">Administrativo</span>
                  </div>
                  <div class="flex flex-col items-center text-center p-4 bg-gray-50 rounded-xl hover:bg-[#0C245C]/5 transition-colors">
                    <div class="w-12 h-12 bg-[#0C245C] rounded-xl flex items-center justify-center mb-3">
                      <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                      </svg>
                    </div>
                    <span class="font-semibold text-[#0C245C]">Operativo</span>
                  </div>
                  <div class="flex flex-col items-center text-center p-4 bg-gray-50 rounded-xl hover:bg-[#0C245C]/5 transition-colors">
                    <div class="w-12 h-12 bg-[#0C245C] rounded-xl flex items-center justify-center mb-3">
                      <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                      </svg>
                    </div>
                    <span class="font-semibold text-[#0C245C]">Control</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="h-1 bg-gradient-to-r from-[#0C245C] to-transparent"></div>
        </div>

        <!-- Service 4 -->
        <div class="reveal bg-white rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-100 group" style="--d: 300ms">
          <div class="p-8">
            <div class="flex items-start gap-6">
              <div class="w-16 h-16 bg-gradient-to-br from-[#0C245C] to-[#1e4a8f] rounded-2xl flex items-center justify-center flex-shrink-0 shadow-lg group-hover:scale-110 transition-transform duration-300">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-2xl font-bold text-[#0C245C] mb-3">Inteligencia Logística</h3>
                <p class="text-gray-600 leading-relaxed text-lg mb-4">
                  Visualiza tus datos operativos ya analizados en tiempo real, aprende a tomar decisiones estratégicas.
                </p>
                <div class="grid sm:grid-cols-2 gap-3">
                  <div class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg">
                    <div class="w-2 h-2 bg-[#0C245C] rounded-full"></div>
                    <span class="text-gray-700 font-medium">Simplifica la operación</span>
                  </div>
                  <div class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg">
                    <div class="w-2 h-2 bg-[#0C245C] rounded-full"></div>
                    <span class="text-gray-700 font-medium">Proyecta grandes resultados</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="h-1 bg-gradient-to-r from-[#0C245C] to-transparent"></div>
        </div>

      </div>
    </div>

  </div>

  <!-- ===== Typewriter + Reveal Script ===== -->
  <script is:inline>
    const prefersReduced =
      typeof window !== "undefined" &&
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // -------- Reveal on load (and on scroll) --------
    const revealEls = Array.from(document.querySelectorAll(".reveal"));

    if (!prefersReduced) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12 }
      );

      revealEls.forEach((el) => io.observe(el));
    } else {
      // No motion: just show
      revealEls.forEach((el) => el.classList.add("is-in"));
    }

    // -------- Typewriter (2 lines) --------
    const wrap = document.querySelector(".typewrap");
    if (wrap) {
      const raw = wrap.getAttribute("data-type-lines") || "";
      const lines = raw.split("|").map((s) => s.trim()).filter(Boolean);

      const lineEls = Array.from(wrap.querySelectorAll(".type-line"));
      const textEls = Array.from(wrap.querySelectorAll(".type-line .type-text"));
      const caretEls = Array.from(wrap.querySelectorAll(".type-line .caret"));

      // Reduced motion: render full instantly
      if (prefersReduced) {
        lines.forEach((t, i) => {
          if (textEls[i]) textEls[i].textContent = t;
          if (caretEls[i]) caretEls[i].style.display = "none";
        });
      } else {
        // Only keep one caret visible while typing
        caretEls.forEach((c, i) => (c.style.opacity = i === 0 ? "1" : "0"));

        const speed = 28;      // ms per character
        const linePause = 260; // pause between lines

        let li = 0;
        let ci = 0;

        const typeTick = () => {
          if (li >= lines.length) {
            // end: show only last caret and keep blinking
            caretEls.forEach((c, i) => (c.style.opacity = i === lines.length - 1 ? "1" : "0"));
            return;
          }

          const current = lines[li];
          if (!textEls[li]) return;

          textEls[li].textContent = current.slice(0, ci);

          if (ci < current.length) {
            ci++;
            setTimeout(typeTick, speed);
          } else {
            // line complete → switch caret to next line
            caretEls.forEach((c, i) => (c.style.opacity = i === li ? "1" : "0"));
            li++;
            ci = 0;

            // enable next caret
            caretEls.forEach((c, i) => (c.style.opacity = i === li ? "1" : "0"));

            setTimeout(typeTick, linePause);
          }
        };

        // Start typing when header is visible (better UX)
        const startWhenVisible = () => {
          const h = wrap.closest("h1");
          if (!h) return typeTick();

          const ioType = new IntersectionObserver((entries) => {
            if (entries[0]?.isIntersecting) {
              ioType.disconnect();
              typeTick();
            }
          }, { threshold: 0.35 });

          ioType.observe(h);
        };

        startWhenVisible();
      }
    }
  </script>

  <style>
    /* ---- Reveal animation (fade + slide) ---- */
    .reveal {
      opacity: 0;
      transform: translateY(14px);
      filter: blur(4px);
      transition:
        opacity 700ms cubic-bezier(.2,.8,.2,1),
        transform 700ms cubic-bezier(.2,.8,.2,1),
        filter 700ms cubic-bezier(.2,.8,.2,1);
      transition-delay: var(--d, 0ms);
      will-change: opacity, transform, filter;
    }
    .reveal.is-in {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }

    /* ---- Typewriter ---- */
    .typewrap {
      min-height: 1em;
    }
    .type-line {
      white-space: nowrap;
    }
    @media (max-width: 640px) {
      .type-line { white-space: normal; }
    }

    .caret {
      display: inline-block;
      width: .6ch;
      margin-left: 2px;
      border-right: 3px solid currentColor;
      transform: translateY(1px);
      animation: blink 900ms step-end infinite;
      opacity: 1;
    }
    @keyframes blink {
      50% { opacity: 0; }
    }

    @media (prefers-reduced-motion: reduce) {
      .reveal { opacity: 1; transform: none; filter: none; transition: none; }
      .caret { animation: none; display: none; }
    }
  </style>
</section>
