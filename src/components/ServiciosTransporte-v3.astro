---

<section class="bg-gradient-to-b from-white via-gray-50 to-white px-4">
  <div class="max-w-7xl mx-auto pt-20 md:pt-24 pb-10">
    <div class="max-w-3xl mb-10 md:mb-14">
      <span
        class="st-reveal inline-block px-4 py-2 bg-[#0C245C]/10 text-[#0C245C] text-sm font-semibold rounded-full mb-6"
        style="--d:0ms"
      >
        {sectionPill}
      </span>

      <h1 class="text-5xl md:text-6xl font-extrabold text-[#0C245C] leading-tight mb-6 tracking-tight">
        <span
          class="st-typewrap inline-block align-top"
          data-type-lines="Impulsa tu operación,|brinda un gran servicio"
        >
          <span class="st-type-fallback block">
            Impulsa tu operación,<br />brinda un gran servicio
          </span>

          <span class="st-type-live hidden">
            <span class="st-type-line block">
              <span class="st-type-text"></span><span class="st-caret" aria-hidden="true"></span>
            </span>
            <span class="st-type-line block">
              <span class="st-type-text"></span><span class="st-caret" aria-hidden="true"></span>
            </span>
          </span>
        </span>
      </h1>

      <p class="st-reveal text-xl text-gray-600 leading-relaxed" style="--d:220ms">
        {sectionDesc}
      </p>
    </div>

    <div class="flex flex-col gap-8 md:gap-10">
      {services.map((s) => (
        <ServiceCard
          id={s.id}
          title={s.title}
          desc={s.desc}
          chips={s.chips}
          delay={s.delay}
          badge={s.badge}
          icon={s.icon}
          image={s.image}
          href="https://wa.me/525524685599?text=Hola%20%F0%9F%91%8B%20Vengo%20desde%20tu%20sitio%20web.%20Me%20interesa%20agendar%20una%20reuni%C3%B3n%20para%20conocer%20c%C3%B3mo%20pueden%20ayudarme%20con%20transporte%20y%20log%C3%ADstica.%20%C2%BFMe%20compartes%20disponibilidad%20esta%20semana%3F"
          cta="Agendar diagnóstico"
        />
      ))}
    </div>
  </div>

  <script is:inline>
    const prefersReduced =
      window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const revealEls = Array.from(document.querySelectorAll(".st-reveal"));
    if (prefersReduced) {
      revealEls.forEach((el) => el.classList.add("st-in"));
    } else if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("st-in");
            io.unobserve(e.target);
          }
        }
      }, { threshold: 0.12 });

      revealEls.forEach((el) => io.observe(el));
      setTimeout(() => revealEls.forEach((el) => el.classList.add("st-in")), 1100);
    } else {
      revealEls.forEach((el) => el.classList.add("st-in"));
    }

    const wrap = document.querySelector(".st-typewrap");
    if (wrap) {
      const live = wrap.querySelector(".st-type-live");
      const fallback = wrap.querySelector(".st-type-fallback");

      if (prefersReduced) {
        if (live) live.classList.add("hidden");
        if (fallback) fallback.classList.remove("hidden");
      } else if (live && fallback) {
        fallback.classList.add("hidden");
        live.classList.remove("hidden");

        const raw = wrap.getAttribute("data-type-lines") || "";
        const lines = raw.split("|").map((s) => s.trim()).filter(Boolean);

        const textEls = Array.from(wrap.querySelectorAll(".st-type-text"));
        const caretEls = Array.from(wrap.querySelectorAll(".st-caret"));
        caretEls.forEach((c, i) => (c.style.opacity = i === 0 ? "1" : "0"));

        const speed = 28;
        const linePause = 260;
        let li = 0, ci = 0;

        const tick = () => {
          if (li >= lines.length) {
            caretEls.forEach((c, i) => (c.style.opacity = i === lines.length - 1 ? "1" : "0"));
            return;
          }

          const cur = lines[li];
          if (!textEls[li]) return;

          textEls[li].textContent = cur.slice(0, ci);

          if (ci < cur.length) {
            ci++;
            setTimeout(tick, speed);
          } else {
            li++;
            ci = 0;
            caretEls.forEach((c, i) => (c.style.opacity = i === li ? "1" : "0"));
            setTimeout(tick, linePause);
          }
        };

        tick();
      }
    }
  </script>

  <style>
    .st-reveal {
      opacity: 0;
      transform: translateY(14px);
      filter: blur(4px);
    }

    .st-reveal.st-in {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
      transition:
        opacity 700ms cubic-bezier(.2,.8,.2,1),
        transform 700ms cubic-bezier(.2,.8,.2,1),
        filter 700ms cubic-bezier(.2,.8,.2,1);
      transition-delay: var(--d, 0ms);
    }

    .st-caret {
      display: inline-block;
      width: .6ch;
      margin-left: 2px;
      border-right: 3px solid currentColor;
      transform: translateY(1px);
      animation: st-blink 900ms step-end infinite;
      opacity: 1;
    }

    @keyframes st-blink {
      50% { opacity: 0; }
    }

    .st-type-line {
      white-space: nowrap;
    }

    @media (max-width: 640px) {
      .st-type-line {
        white-space: normal;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .st-reveal {
        opacity: 1 !important;
        transform: none !important;
        filter: none !important;
      }

      .st-caret {
        animation: none;
        display: none;
      }
    }
  </style>
</section>