---
// ModulosBasicosTransporte.astro
---
<section class="relative bg-[#0C245C] py-24 px-4 overflow-hidden" id="servicios">
  <!-- Decorative background elements -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-0 right-0 w-96 h-96 bg-cyan-400/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-white/5 rounded-full blur-3xl"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-cyan-400/3 rounded-full blur-3xl"></div>
  </div>

  <div class="max-w-7xl mx-auto relative z-10">
    <!-- Header Section -->
    <div class="text-center mb-14">
      <h2 class="text-5xl md:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight">
        Nuestros <br class="md:hidden" />
        <span class="relative inline-block mt-2">
          <span class="relative z-10 bg-gradient-to-r from-cyan-400 to-cyan-300 bg-clip-text text-transparent">
            Servicios
          </span>
          <span class="absolute -bottom-2 left-0 w-full h-4 bg-gradient-to-r from-cyan-400/30 to-transparent blur-sm"></span>
        </span>
      </h2>

      <p class="text-xl md:text-2xl text-gray-300 max-w-3xl mx-auto leading-relaxed">
        Transformamos oportunidades en resultados a través de soluciones ágiles, sustentadas en sistemas y con impacto real.
      </p>
    </div>

    <!-- ✅ Compact 4-block grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-7 lg:gap-8">

      <!-- Card 2 -->
      <div class="group relative overflow-hidden rounded-3xl shadow-2xl hover:shadow-cyan-400/20 transition-all duration-500 hover:-translate-y-1 bg-white">
        <div class="relative aspect-[16/11] md:aspect-[16/12] overflow-hidden">
          <img
            src="https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=900&h=650&fit=crop"
            alt="Consultoría en Logística y Transporte"
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0C245C] via-[#0C245C]/80 to-transparent"></div>

          <div class="absolute inset-0 p-7 md:p-8 flex flex-col justify-end">
            <div class="w-14 h-14 bg-white/20 backdrop-blur-md rounded-2xl flex items-center justify-center mb-5 group-hover:bg-cyan-400 group-hover:scale-110 transition-all duration-500 shadow-lg">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
            </div>

            <h4 class="text-2xl font-bold text-white mb-1">Consultoría en Logística y Transporte</h4>
            <div class="mt-4 inline-flex items-center text-cyan-200 font-semibold group-hover:translate-x-2 transition-transform duration-300">
              <a href="#consultoria-logistica-transporte" class="hover:text-cyan-300">Explorar</a>
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 4 -->
      <div class="group relative overflow-hidden rounded-3xl shadow-2xl hover:shadow-cyan-400/20 transition-all duration-500 hover:-translate-y-1 bg-white">
        <div class="relative aspect-[16/11] md:aspect-[16/12] overflow-hidden">
          <img
            src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=900&h=650&fit=crop"
            alt="Inteligencia logística"
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0C245C] via-[#0C245C]/80 to-transparent"></div>

          <div class="absolute inset-0 p-7 md:p-8 flex flex-col justify-end">
            <div class="w-14 h-14 bg-white/20 backdrop-blur-md rounded-2xl flex items-center justify-center mb-5 group-hover:bg-cyan-400 group-hover:scale-110 transition-all duration-500 shadow-lg">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>

            <h4 class="text-2xl font-bold text-white mb-1">Inteligencia logística</h4>
            <div class="mt-4 inline-flex items-center text-cyan-200 font-semibold group-hover:translate-x-2 transition-transform duration-300">
              <a href="#inteligencia-logistica" class="hover:text-cyan-300">Explorar</a>
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="group relative overflow-hidden rounded-3xl shadow-2xl hover:shadow-cyan-400/20 transition-all duration-500 hover:-translate-y-1 bg-white">
        <div class="relative aspect-[16/11] md:aspect-[16/12] overflow-hidden">
          <img
            src="https://media.istockphoto.com/id/1416553947/es/foto/equipo-de-negocios-concentrado-exitoso-que-trabaja-junto-con-computadoras-en-el-lugar-de.jpg?s=612x612&w=0&k=20&c=DLAlJvXzP6ty3WJnBBtXfVYuYyajatxdJWqsTI23UNQ="
            alt="Gemelo Logístico"
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0C245C] via-[#0C245C]/80 to-transparent"></div>

          <div class="absolute inset-0 p-7 md:p-8 flex flex-col justify-end">
            <div class="w-14 h-14 bg-white/20 backdrop-blur-md rounded-2xl flex items-center justify-center mb-5 group-hover:bg-cyan-400 group-hover:scale-110 transition-all duration-500 shadow-lg">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>

            <h4 class="text-2xl font-bold text-white mb-1">Gemelo Logístico</h4>

            <div class="mt-4 inline-flex items-center text-cyan-200 font-semibold group-hover:translate-x-2 transition-transform duration-300">
              <a href="#gemelo-logistico" class="hover:text-cyan-300">Explorar</a>
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 1 -->
      <div class="group relative overflow-hidden rounded-3xl shadow-2xl hover:shadow-cyan-400/20 transition-all duration-500 hover:-translate-y-1 bg-white">
        <div class="relative aspect-[16/11] md:aspect-[16/12] overflow-hidden">
          <img
            src="https://images.unsplash.com/photo-1601584115197-04ecc0da31d7?w=900&h=650&fit=crop"
            alt="Operación general de Transporte"
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0C245C] via-[#0C245C]/80 to-transparent"></div>

          <div class="absolute inset-0 p-7 md:p-8 flex flex-col justify-end">
            <div class="w-14 h-14 bg-white/20 backdrop-blur-md rounded-2xl flex items-center justify-center mb-5 group-hover:bg-cyan-400 group-hover:scale-110 transition-all duration-500 shadow-lg">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
              </svg>
            </div>

            <h4 class="text-2xl font-bold text-white mb-1">Socios del transporte</h4>
            <div class="mt-4 inline-flex items-center text-cyan-200 font-semibold group-hover:translate-x-2 transition-transform duration-300">
              <a href="#socios-del-transporte" class="hover:text-cyan-300">Explorar</a>
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-14"></div>
  </div>
</section>