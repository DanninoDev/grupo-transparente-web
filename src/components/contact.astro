---
type SocialIcon = "in" | "mail" | "ig" | "fb";

type SocialItem = {
  name: string;
  href: string;
  icon: SocialIcon;
};

const socials: SocialItem[] = [
  { name: "LinkedIn", href: "https://www.linkedin.com/company/grupotransparente01/", icon: "in" },
  { name: "Email", href: "mailto:diego@consultoriatransparente.com", icon: "mail" },
  { name: "Instagram", href: "https://www.instagram.com/grupo.transparente/", icon: "ig" },
  { name: "Facebook", href: "https://www.facebook.com/profile.php?id=100085576855283", icon: "fb" },
];

const icons: Record<SocialIcon, string> = {
  in: `
    <path fill="currentColor" d="M6.9 6.8H4V20h2.9V6.8ZM5.45 3.2a1.7 1.7 0 1 0 0 3.4 1.7 1.7 0 0 0 0-3.4Z"/>
    <path fill="currentColor" d="M20 20h-2.9v-6.4c0-1.5-.5-2.5-1.8-2.5-1 0-1.6.7-1.9 1.3-.1.3-.1.7-.1 1.1V20H10.4V6.8h2.8v1.8c.4-.9 1.4-2.1 3.3-2.1 2.3 0 4 1.5 4 4.8V20Z"/>
  `,
  mail: `
    <rect x="4" y="6" width="16" height="12" rx="2" stroke="currentColor" fill="none"/>
    <path d="M5 7l7 5 7-5" stroke="currentColor" fill="none"/>
  `,
  ig: `
    <rect x="4" y="4" width="16" height="16" rx="4" stroke="currentColor" fill="none"/>
    <circle cx="12" cy="12" r="3.2" stroke="currentColor" fill="none"/>
    <circle cx="16.5" cy="7.5" r=".8" fill="currentColor"/>
  `,
  fb: `
    <path fill="currentColor" d="M14 9h2V6h-2c-2 0-3.5 1.2-3.5 3.6V12H8v3h2.5v5H13v-5h2.7l.3-3H13V9.9c0-.6.2-.9 1-.9Z"/>
  `,
};
---

<section id="contacto" class="relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-br from-[#0C245C] via-[#0B1E4C] to-[#071533]"></div>

  <div class="pointer-events-none absolute inset-0">
    <div
      class="absolute inset-0 opacity-[0.10]"
      style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,.35) 1px, transparent 0); background-size: 40px 40px;"
    ></div>
    <div class="absolute -top-44 -left-44 h-[520px] w-[520px] rounded-full bg-cyan-400/20 blur-3xl"></div>
    <div class="absolute -bottom-48 -right-48 h-[560px] w-[560px] rounded-full bg-indigo-400/20 blur-3xl"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/35 via-transparent to-transparent"></div>
  </div>

  <div class="relative mx-auto max-w-6xl px-4 py-16 sm:py-20">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-3 rounded-full bg-white/10 px-4 py-2 ring-1 ring-white/15 backdrop-blur">
        <span class="h-2 w-2 rounded-full bg-cyan-300 animate-pulse"></span>
        <p class="text-xs font-semibold tracking-[0.22em] text-white/85 uppercase">
          Contacto · Consultoría & logística
        </p>
      </div>

      <h2 class="mt-6 text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white leading-[1.05]">
        Hablemos y llevemos tu transporte
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-white to-cyan-200"> al siguiente nivel</span>.
      </h2>

      <p class="mt-4 text-white/70 text-base sm:text-lg">
        Cuéntanos tu reto: procesos, control operativo, KPIs o inteligencia logística. Te respondemos rápido.
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      <aside class="lg:col-span-5">
        <div class="h-full rounded-3xl bg-white/10 ring-1 ring-white/15 backdrop-blur-xl shadow-2xl shadow-black/25 overflow-hidden">
          <div class="p-6 sm:p-7">
            <h3 class="text-xl font-bold text-white">Información de contacto</h3>
            <p class="mt-2 text-sm text-white/70">
              Elige el canal que prefieras. También puedes agendar una reunión directamente.
            </p>

            <div class="mt-6 space-y-3">
              <div class="rounded-2xl bg-white/10 ring-1 ring-white/12 p-4">
                <p class="text-xs font-semibold text-white/60 uppercase tracking-wide">Correo</p>
                <a
                  class="mt-1 inline-flex items-center gap-2 text-white font-semibold hover:text-cyan-200 transition-colors break-all"
                  href="mailto:diego@consultoriatransparente.com"
                >
                  diego@consultoriatransparente.com
                  <span class="text-white/50">→</span>
                </a>
              </div>

              <div class="rounded-2xl bg-white/10 ring-1 ring-white/12 p-4">
                <p class="text-xs font-semibold text-white/60 uppercase tracking-wide">Horario</p>
                <p class="mt-1 text-white font-semibold">Lun–Vie · 9:00–18:00</p>
                <p class="text-sm text-white/65">Respuesta típica: 24–48 hrs</p>
              </div>

              <div class="rounded-2xl bg-white/10 ring-1 ring-white/12 p-4">
                <p class="text-xs font-semibold text-white/60 uppercase tracking-wide">Enfoque</p>
                <div class="mt-2 flex flex-wrap gap-2">
                  <span class="chip">KPIs</span>
                  <span class="chip">Control operativo</span>
                  <span class="chip">Procesos</span>
                  <span class="chip">Inteligencia logística</span>
                </div>
              </div>
            </div>

            <div class="mt-6">
              <p class="text-xs font-semibold text-white/60 uppercase tracking-wide">Síguenos</p>
              <div class="mt-3 flex flex-wrap gap-2">
                {socials.map((s) => (
                  <a
                    href={s.href}
                    target={s.href.startsWith("http") ? "_blank" : undefined}
                    rel={s.href.startsWith("http") ? "noopener noreferrer" : undefined}
                    class="group inline-flex items-center gap-2 rounded-2xl bg-white/10 ring-1 ring-white/15 px-4 py-2 text-sm font-semibold text-white/85 hover:bg-white/15 hover:text-white transition-all"
                    aria-label={s.name}
                  >
                    <span class="grid place-items-center h-9 w-9 rounded-xl bg-white/10 ring-1 ring-white/10 group-hover:bg-white/15 transition-colors">
                      <svg
                        class="h-5 w-5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        aria-hidden="true"
                        set:html={icons[s.icon]}
                      ></svg>
                    </span>
                    {s.name}
                  </a>
                ))}
              </div>
            </div>

            <div class="mt-7 flex flex-col sm:flex-row gap-3">
              <a
                href="https://wa.me/524424685599?text=Hola%2C%20vengo%20desde%20su%20sitio%20web%20y%20quiero%20informaci%C3%B3n%20sobre%20sus%20servicios."
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 rounded-2xl bg-white text-[#0C245C] px-5 py-3 text-sm font-extrabold shadow-lg shadow-black/20 hover:shadow-xl hover:shadow-black/25 transition-shadow"
              >
                Agendar por WhatsApp
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M5 12h14" />
                  <path d="m13 5 7 7-7 7" />
                </svg>
              </a>

              <a
                href="mailto:diego@consultoriatransparente.com"
                class="inline-flex items-center justify-center gap-2 rounded-2xl bg-white/10 text-white px-5 py-3 text-sm font-bold ring-1 ring-white/15 hover:bg-white/15 transition-colors"
              >
                Enviar correo
              </a>
            </div>
          </div>
        </div>
      </aside>

      <div class="lg:col-span-7">
        <div class="h-full rounded-3xl bg-white/10 ring-1 ring-white/15 backdrop-blur-xl shadow-2xl shadow-black/25 overflow-hidden">
          <div class="p-6 sm:p-7">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="text-xl font-bold text-white">Envíanos un mensaje</h3>
                <p class="mt-2 text-sm text-white/70">Te responderemos con una propuesta o siguientes pasos.</p>
              </div>

              <span class="hidden sm:inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-white/80 ring-1 ring-white/15">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-300"></span>
                Respuesta rápida
              </span>
            </div>

            <form id="contact-form" class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="sm:col-span-1">
                <label for="nombre" class="text-xs font-semibold text-white/70 uppercase tracking-wide">Nombre</label>
                <input
                  id="nombre"
                  name="nombre"
                  required
                  placeholder="Tu nombre"
                  class="mt-2 w-full rounded-2xl bg-white/10 text-white placeholder:text-white/45 ring-1 ring-white/15 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-cyan-300/70 focus:bg-white/12 transition"
                />
              </div>

              <div class="sm:col-span-1">
                <label for="empresa" class="text-xs font-semibold text-white/70 uppercase tracking-wide">Empresa</label>
                <input
                  id="empresa"
                  name="empresa"
                  placeholder="Tu empresa (opcional)"
                  class="mt-2 w-full rounded-2xl bg-white/10 text-white placeholder:text-white/45 ring-1 ring-white/15 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-cyan-300/70 focus:bg-white/12 transition"
                />
              </div>

              <div class="sm:col-span-1">
                <label for="email" class="text-xs font-semibold text-white/70 uppercase tracking-wide">Email</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  placeholder="tucorreo@empresa.com"
                  class="mt-2 w-full rounded-2xl bg-white/10 text-white placeholder:text-white/45 ring-1 ring-white/15 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-cyan-300/70 focus:bg-white/12 transition"
                />
              </div>

              <div class="sm:col-span-1">
                <label for="telefono" class="text-xs font-semibold text-white/70 uppercase tracking-wide">Teléfono</label>
                <input
                  id="telefono"
                  name="telefono"
                  placeholder="+52 ..."
                  class="mt-2 w-full rounded-2xl bg-white/10 text-white placeholder:text-white/45 ring-1 ring-white/15 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-cyan-300/70 focus:bg-white/12 transition"
                />
              </div>

              <div class="sm:col-span-2">
                <label for="mensaje" class="text-xs font-semibold text-white/70 uppercase tracking-wide">¿Qué necesitas?</label>
                <textarea
                  id="mensaje"
                  name="mensaje"
                  rows="5"
                  required
                  placeholder="Cuéntanos brevemente tu reto: KPIs, control operativo, procesos, tecnología..."
                  class="mt-2 w-full rounded-2xl bg-white/10 text-white placeholder:text-white/45 ring-1 ring-white/15 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-cyan-300/70 focus:bg-white/12 transition resize-none"
                ></textarea>
              </div>

              <div class="sm:col-span-2 flex flex-col gap-3">
                <div class="flex flex-col sm:flex-row gap-3 sm:items-center sm:justify-between">
                  <p class="text-xs text-white/60">
                    Al enviar aceptas ser contactado para dar seguimiento. 🔒
                  </p>

                  <button
                    id="submit-btn"
                    type="submit"
                    class="inline-flex items-center justify-center gap-2 rounded-2xl bg-white text-[#0C245C] px-5 py-3 text-sm font-extrabold shadow-lg shadow-black/20 hover:shadow-xl hover:shadow-black/25 transition-shadow disabled:opacity-60 disabled:cursor-not-allowed"
                  >
                    <span id="submit-text">Enviar mensaje</span>
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M22 2 11 13" />
                      <path d="M22 2 15 22l-4-9-9-4 20-7Z" />
                    </svg>
                  </button>
                </div>

                <div id="form-status" class="hidden rounded-2xl px-4 py-3 text-sm font-semibold"></div>
              </div>
            </form>

            <div class="mt-6 rounded-2xl bg-white/5 ring-1 ring-white/10 p-4 text-sm text-white/70">
              💡 Tip: Si ya tienes métricas/KPIs, menciona qué herramienta usas (Excel, Power BI, ERP) para acelerar el diagnóstico.
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  type ContactResponse = {
    ok: boolean;
    message?: string;
  };

  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const statusBox = document.getElementById("form-status") as HTMLDivElement | null;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;
  const submitText = document.getElementById("submit-text") as HTMLSpanElement | null;

  form?.addEventListener("submit", async (e: SubmitEvent) => {
    e.preventDefault();

    if (!form || !statusBox || !submitBtn || !submitText) return;

    const formData = new FormData(form);
    const payload = Object.fromEntries(formData.entries());

    statusBox.className = "hidden rounded-2xl px-4 py-3 text-sm font-semibold";
    statusBox.textContent = "";

    submitBtn.disabled = true;
    submitText.textContent = "Enviando...";

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(payload),
      });

      const data = (await res.json()) as ContactResponse;

      if (!res.ok || !data.ok) {
        throw new Error(data?.message || "No se pudo enviar el mensaje.");
      }

      form.reset();

      statusBox.className =
        "rounded-2xl px-4 py-3 text-sm font-semibold bg-emerald-400/15 text-emerald-200 ring-1 ring-emerald-300/20";
      statusBox.textContent = "✅ Tu mensaje fue enviado correctamente. Pronto te contactaremos.";
    } catch (error) {
      statusBox.className =
        "rounded-2xl px-4 py-3 text-sm font-semibold bg-red-400/15 text-red-200 ring-1 ring-red-300/20";

      statusBox.textContent =
        error instanceof Error
          ? `❌ ${error.message}`
          : "❌ Ocurrió un error al enviar el formulario.";
    } finally {
      submitBtn.disabled = false;
      submitText.textContent = "Enviar mensaje";
    }
  });
</script>

<style>
  .chip{
    display:inline-flex;
    align-items:center;
    gap:.4rem;
    padding:.35rem .7rem;
    border-radius:9999px;
    background:rgba(255,255,255,.10);
    border:1px solid rgba(255,255,255,.15);
    color:rgba(255,255,255,.85);
    font-size:12px;
    font-weight:700;
  }

  @media (prefers-reduced-motion: no-preference) {
    section { animation: contactIn .65s ease-out both; }
    @keyframes contactIn {
      from { opacity: 0; transform: translateY(12px); }
      to   { opacity: 1; transform: translateY(0); }
    }
  }
</style>