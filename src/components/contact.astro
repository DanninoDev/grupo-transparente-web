<section id="contacto" class="relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-br from-[#0C245C] via-[#0B1E4C] to-[#071533]"></div>

  <div class="pointer-events-none absolute inset-0">
    <div
      class="absolute inset-0 opacity-[0.10]"
      style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,.35) 1px, transparent 0); background-size: 40px 40px;"
    ></div>
    <div class="absolute -top-44 -left-44 h-[520px] w-[520px] rounded-full bg-cyan-400/20 blur-3xl"></div>
    <div class="absolute -bottom-48 -right-48 h-[560px] w-[560px] rounded-full bg-indigo-400/20 blur-3xl"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/35 via-transparent to-transparent"></div>
  </div>

  <div class="relative mx-auto max-w-6xl px-4 py-16 sm:py-20">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-3 rounded-full bg-white/10 px-4 py-2 ring-1 ring-white/15 backdrop-blur">
        <span class="h-2 w-2 rounded-full bg-cyan-300 animate-pulse"></span>
        <p class="text-xs font-semibold tracking-[0.22em] text-white/85 uppercase">
          Contacto · Consultoría & logística
        </p>
      </div>

      <h2 class="mt-6 text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white leading-[1.05]">
        Hablemos y llevemos tu transporte
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-white to-cyan-200"> al siguiente nivel</span>.
      </h2>

      <p class="mt-4 text-white/70 text-base sm:text-lg">
        Cuéntanos tu reto: procesos, control operativo, KPIs o inteligencia logística. Te respondemos rápido.
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      <aside class="lg:col-span-5">
        <div class="h-full rounded-3xl bg-white/10 ring-1 ring-white/15 backdrop-blur-xl shadow-2xl shadow-black/25 overflow-hidden">
          <div class="p-6 sm:p-7">
            <h3 class="text-xl font-bold text-white">Información de contacto</h3>
            <p class="mt-2 text-sm text-white/70">
              Elige el canal que prefieras. También puedes agendar una reunión directamente.
            </p>

            <div class="mt-6 space-y-3">
              <div class="rounded-2xl bg-white/10 ring-1 ring-white/12 p-4">
                <p class="text-xs font-semibold text-white/60 uppercase tracking-wide">Correo</p>
                <a
                  class="mt-1 inline-flex items-center gap-2 text-white font-semibold hover:text-cyan-200 transition-colors break-all"
                  href="mailto:diego@consultoriatransparente.com"
                >
                  diego@consultoriatransparente.com
                </a>
              </div>

              <div class="rounded-2xl bg-white/10 ring-1 ring-white/12 p-4">
                <p class="text-xs font-semibold text-white/60 uppercase tracking-wide">Horario</p>
                <p class="mt-1 text-white font-semibold">Lun–Vie · 9:00–18:00</p>
                <p class="text-sm text-white/65">Respuesta típica: 24–48 hrs</p>
              </div>
            </div>
          </div>
        </div>
      </aside>

      <div class="lg:col-span-7">
        <div class="h-full rounded-3xl bg-white/10 ring-1 ring-white/15 backdrop-blur-xl shadow-2xl shadow-black/25 overflow-hidden">
          <div class="p-6 sm:p-7">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="text-xl font-bold text-white">Envíanos un mensaje</h3>
                <p class="mt-2 text-sm text-white/70">Te responderemos con una propuesta o siguientes pasos.</p>
              </div>
            </div>

            <form id="contact-form" class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="sm:col-span-1">
                <label for="nombre" class="text-xs font-semibold text-white/70 uppercase tracking-wide">Nombre</label>
                <input
                  id="nombre"
                  name="nombre"
                  required
                  placeholder="Tu nombre"
                  class="mt-2 w-full rounded-2xl bg-white/10 text-white placeholder:text-white/45 ring-1 ring-white/15 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-cyan-300/70"
                />
              </div>

              <div class="sm:col-span-1">
                <label for="empresa" class="text-xs font-semibold text-white/70 uppercase tracking-wide">Empresa</label>
                <input
                  id="empresa"
                  name="empresa"
                  placeholder="Tu empresa (opcional)"
                  class="mt-2 w-full rounded-2xl bg-white/10 text-white placeholder:text-white/45 ring-1 ring-white/15 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-cyan-300/70"
                />
              </div>

              <div class="sm:col-span-1">
                <label for="email" class="text-xs font-semibold text-white/70 uppercase tracking-wide">Email</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  placeholder="tucorreo@empresa.com"
                  class="mt-2 w-full rounded-2xl bg-white/10 text-white placeholder:text-white/45 ring-1 ring-white/15 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-cyan-300/70"
                />
              </div>

              <div class="sm:col-span-1">
                <label for="telefono" class="text-xs font-semibold text-white/70 uppercase tracking-wide">Teléfono</label>
                <input
                  id="telefono"
                  name="telefono"
                  placeholder="+52 ..."
                  class="mt-2 w-full rounded-2xl bg-white/10 text-white placeholder:text-white/45 ring-1 ring-white/15 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-cyan-300/70"
                />
              </div>

              <div class="sm:col-span-2 hidden">
                <label for="website">Website</label>
                <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
              </div>

              <div class="sm:col-span-2">
                <label for="mensaje" class="text-xs font-semibold text-white/70 uppercase tracking-wide">¿Qué necesitas?</label>
                <textarea
                  id="mensaje"
                  name="mensaje"
                  rows="5"
                  required
                  placeholder="Cuéntanos brevemente tu reto..."
                  class="mt-2 w-full rounded-2xl bg-white/10 text-white placeholder:text-white/45 ring-1 ring-white/15 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-cyan-300/70 resize-none"
                ></textarea>
              </div>

              <div class="sm:col-span-2 flex flex-col gap-3">
                <button
                  id="submit-btn"
                  type="submit"
                  class="inline-flex items-center justify-center gap-2 rounded-2xl bg-white text-[#0C245C] px-5 py-3 text-sm font-extrabold disabled:opacity-70 disabled:cursor-not-allowed"
                >
                  <span id="submit-text">Enviar mensaje</span>
                </button>

                <div id="form-status" class="hidden rounded-2xl px-4 py-3 text-sm font-semibold"></div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("contact-form");
    const statusBox = document.getElementById("form-status");
    const submitBtn = document.getElementById("submit-btn");
    const submitText = document.getElementById("submit-text");

    if (!form || !statusBox || !submitBtn || !submitText) return;

    const showStatus = (type, message) => {
      const base = "rounded-2xl px-4 py-3 text-sm font-semibold";
      const success = " bg-emerald-400/15 text-emerald-200 ring-1 ring-emerald-300/20";
      const error = " bg-red-400/15 text-red-200 ring-1 ring-red-300/20";

      statusBox.className = base + (type === "success" ? success : error);
      statusBox.textContent = message;
      statusBox.classList.remove("hidden");
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());

      statusBox.className = "hidden rounded-2xl px-4 py-3 text-sm font-semibold";
      statusBox.textContent = "";

      submitBtn.disabled = true;
      submitText.textContent = "Enviando...";

      try {
        const res = await fetch("/api/contact.php", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          body: JSON.stringify(payload)
        });

        const text = await res.text();
        let data = null;

        try {
          data = JSON.parse(text);
        } catch {
          throw new Error("La respuesta del servidor no es válida.");
        }

        if (!res.ok || !data?.ok) {
          throw new Error(data?.message || "No se pudo enviar el mensaje.");
        }

        form.reset();
        showStatus("success", "✅ Tu mensaje fue enviado correctamente. Pronto te contactaremos.");
      } catch (error) {
        showStatus(
          "error",
          error instanceof Error
            ? `❌ ${error.message}`
            : "❌ Ocurrió un error al enviar el formulario."
        );
      } finally {
        submitBtn.disabled = false;
        submitText.textContent = "Enviar mensaje";
      }
    });
  });
</script>