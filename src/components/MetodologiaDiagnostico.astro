---
// MetodologiaDiagnostico.astro

const sections = [
  {
    name: "Procesos & Política",
    tone: "emerald",
    icon: "gear",
    items: [
      ["Tecnología e Información", 40],
      ["Ejecución del Mantenimiento", 50],
      ["Operación de Taller", 50],
      ["Estructura Organizacional", 40],
      ["Nivel de Servicio", 40],
      ["Estrategia de Mantenimiento", 40],
    ],
  },
  {
    name: "Ejecución de Transporte",
    tone: "cyan",
    icon: "doc",
    items: [
      ["Desempeño & KPI's", 36],
      ["Documentación & Despacho", 50],
      ["Control de Entradas & Salidas", 40],
      ["Control de Flota", 30],
    ],
  },
  {
    name: "Operadores",
    tone: "slate",
    icon: "users",
    items: [
      ["Retención & Reconocimiento", 40],
      ["Desempeño", 30],
      ["Documentación", 40],
      ["Entorno Laboral", 30],
      ["Capacitación", 60],
      ["Reclutamiento", 40],
    ],
  },
  {
    name: "Planeación Táctica",
    tone: "rose",
    icon: "clip",
    items: [
      ["Asignación de recursos", 50],
      ["Validación de Presupuesto", 60],
      ["Puntos de recolección", 30],
      ["Operadores", 60],
      ["Evaluación de Capacidades", 50],
      ["Proyección de Volumen", 50],
    ],
  },
];

const toneClasses = {
  emerald: {
    chip: "bg-emerald-500/10 text-emerald-700 ring-1 ring-emerald-500/20",
    bar: "bg-gradient-to-r from-emerald-500 to-emerald-600",
    accent: "text-emerald-600",
    header: "from-emerald-500/12 via-white to-white",
    icon: "bg-emerald-600",
  },
  cyan: {
    chip: "bg-cyan-500/10 text-cyan-700 ring-1 ring-cyan-500/20",
    bar: "bg-gradient-to-r from-cyan-500 to-cyan-600",
    accent: "text-cyan-600",
    header: "from-cyan-500/12 via-white to-white",
    icon: "bg-cyan-600",
  },
  slate: {
    chip: "bg-slate-500/10 text-slate-700 ring-1 ring-slate-500/20",
    bar: "bg-gradient-to-r from-slate-600 to-slate-700",
    accent: "text-slate-600",
    header: "from-slate-500/10 via-white to-white",
    icon: "bg-slate-700",
  },
  rose: {
    chip: "bg-rose-500/10 text-rose-700 ring-1 ring-rose-500/20",
    bar: "bg-gradient-to-r from-rose-500 to-rose-600",
    accent: "text-rose-600",
    header: "from-rose-500/12 via-white to-white",
    icon: "bg-rose-600",
  },
};

const icons = {
  gear: `
    <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
      d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z"/>
    <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
      d="M19.4 15a1.8 1.8 0 0 0 .36 1.98l.05.05a2.2 2.2 0 0 1-1.56 3.76 2.2 2.2 0 0 1-1.56-.64l-.05-.05a1.8 1.8 0 0 0-1.98-.36 1.8 1.8 0 0 0-1.1 1.64V21a2.2 2.2 0 0 1-4.4 0v-.07a1.8 1.8 0 0 0-1.1-1.64 1.8 1.8 0 0 0-1.98.36l-.05.05A2.2 2.2 0 0 1 3 18.2c0-.58.23-1.14.64-1.56l.05-.05A1.8 1.8 0 0 0 4.05 15a1.8 1.8 0 0 0-1.64-1.1H2.34a2.2 2.2 0 0 1 0-4.4h.07a1.8 1.8 0 0 0 1.64-1.1 1.8 1.8 0 0 0-.36-1.98l-.05-.05A2.2 2.2 0 0 1 5.2 3c.58 0 1.14.23 1.56.64l.05.05A1.8 1.8 0 0 0 8.8 4.05 1.8 1.8 0 0 0 9.9 2.41V2.34a2.2 2.2 0 0 1 4.4 0v.07a1.8 1.8 0 0 0 1.1 1.64 1.8 1.8 0 0 0 1.98-.36l.05-.05c.41-.41.97-.64 1.56-.64A2.2 2.2 0 0 1 21 5.2c0 .58-.23 1.14-.64 1.56l-.05.05a1.8 1.8 0 0 0-.36 1.98 1.8 1.8 0 0 0 1.64 1.1h.07a2.2 2.2 0 0 1 0 4.4h-.07a1.8 1.8 0 0 0-1.64 1.1Z"/>
  `,
  doc: `
    <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
      d="M14 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7Z"/>
    <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
      d="M14 2v5h5"/>
    <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
      d="M9 13h6"/>
    <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
      d="M9 17h6"/>
  `,
  users: `
    <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
      d="M16 21v-1a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v1"/>
    <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
      d="M8.5 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"/>
    <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
      d="M23 21v-1a4 4 0 0 0-3-3.87"/>
    <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
      d="M16 3.13a4 4 0 0 1 0 7.75"/>
  `,
  clip: `
    <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
      d="M21 10.5 12.6 18.9a4 4 0 1 1-5.66-5.66l8.49-8.49a3 3 0 0 1 4.24 4.24l-8.49 8.49a2 2 0 1 1-2.83-2.83L15 8.09"/>
  `,
};
---

<section class="relative bg-white overflow-hidden">
  <!-- background: grid + soft blobs -->
  <div class="pointer-events-none absolute inset-0">
    <div
      class="absolute inset-0 opacity-[0.05]"
      style="background-image: radial-gradient(circle at 1px 1px, #0C245C 1px, transparent 0); background-size: 42px 42px;"
    ></div>
    <div class="absolute -top-40 -left-40 h-[520px] w-[520px] rounded-full bg-cyan-400/10 blur-3xl"></div>
    <div class="absolute -bottom-40 -right-40 h-[520px] w-[520px] rounded-full bg-[#0C245C]/10 blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-[1240px] px-4">
    <!-- Header -->
    <header class="mx-auto max-w-3xl text-center">

      <h1 class="mt-6 text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-[#0C245C] leading-[1.05]">
        Nuestra metodología
        <span class="block mt-2 text-transparent bg-clip-text bg-gradient-to-r from-[#0C245C] to-cyan-500">
          en el diagnóstico
        </span>
      </h1>

      <p class="mt-5 text-base sm:text-lg text-slate-600">
        Lectura clara y accionable del desempeño por dimensión, con visualización y desglose por elementos.
      </p>
    </header>

    <!-- Layout -->
    <div class="mt-14 grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Left: Radar + KPIs -->
      <aside class="lg:col-span-5">
        <div class="lg:sticky lg:top-8">
          <div class="rounded-3xl border border-slate-200/70 bg-white shadow-xl shadow-[#0C245C]/5 overflow-hidden">
            <!-- top bar -->
            <div class="relative px-7 py-6 bg-gradient-to-b from-[#0C245C]/5 to-white">
              <div
                class="absolute inset-0 opacity-40"
                style="background: radial-gradient(600px circle at 20% 10%, rgba(34,211,238,.20), transparent 60%);"
              ></div>

              <div class="relative flex items-start justify-between gap-4">
                <div>
                  <h3 class="text-xl font-bold text-[#0C245C]">Evaluación de Dimensiones</h3>
                  <p class="mt-1 text-sm text-slate-500">Análisis multidimensional del transporte</p>
                </div>

                <span class="inline-flex items-center gap-2 rounded-full bg-white px-3 py-1 text-xs font-semibold text-[#0C245C] ring-1 ring-slate-200">
                  <span class="h-1.5 w-1.5 rounded-full bg-rose-500"></span>
                  Ejemplo
                </span>
              </div>

              <!-- KPIs -->
              <div class="relative mt-6 grid grid-cols-3 gap-3">
                <div class="rounded-2xl bg-white/80 ring-1 ring-slate-200 px-4 py-3">
                  <p class="text-[11px] font-semibold tracking-wide text-slate-500 uppercase">Promedio</p>
                  <p class="mt-1 text-xl font-bold text-[#0C245C]">2.1</p>
                </div>
                <div class="rounded-2xl bg-white/80 ring-1 ring-slate-200 px-4 py-3">
                  <p class="text-[11px] font-semibold tracking-wide text-slate-500 uppercase">Mejor</p>
                  <p class="mt-1 text-xl font-bold text-[#0C245C]">3.1</p>
                </div>
                <div class="rounded-2xl bg-white/80 ring-1 ring-slate-200 px-4 py-3">
                  <p class="text-[11px] font-semibold tracking-wide text-slate-500 uppercase">Riesgo</p>
                  <p class="mt-1 text-xl font-bold text-rose-600">2</p>
                </div>
              </div>
            </div>

            <!-- Radar -->
            <div class="px-7 pb-7">
              <div class="relative aspect-square max-w-md mx-auto">
                <!-- legend -->
                <div class="absolute left-0 top-3 flex items-center gap-3 text-[11px] text-slate-500">
                  <span class="inline-flex items-center gap-2">
                    <span class="h-2 w-2 rounded-full bg-[#0C245C] ring-4 ring-[#0C245C]/10"></span> Nivel 5
                  </span>
                  <span class="inline-flex items-center gap-2">
                    <span class="h-2 w-2 rounded-full bg-slate-300 ring-4 ring-slate-200/70"></span> Nivel 1
                  </span>
                </div>

                <svg viewBox="0 0 500 500" class="w-full h-full drop-shadow-sm">
                  <defs>
                    <linearGradient id="dataGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" style="stop-color:#0C245C;stop-opacity:0.18" />
                      <stop offset="100%" style="stop-color:#22d3ee;stop-opacity:0.28" />
                    </linearGradient>
                    <filter id="glow">
                      <feGaussianBlur stdDeviation="2.5" result="coloredBlur" />
                      <feMerge>
                        <feMergeNode in="coloredBlur" />
                        <feMergeNode in="SourceGraphic" />
                      </feMerge>
                    </filter>
                  </defs>

                  <g opacity="0.14">
                    <polygon points="250,80 400,180 350,380 150,380 100,180" fill="none" stroke="#0C245C" stroke-width="1.5" />
                    <polygon points="250,120 360,195 320,350 180,350 140,195" fill="none" stroke="#0C245C" stroke-width="1.5" />
                    <polygon points="250,160 320,210 290,320 210,320 180,210" fill="none" stroke="#0C245C" stroke-width="1.5" />
                    <polygon points="250,200 280,225 270,290 230,290 220,225" fill="none" stroke="#0C245C" stroke-width="1.5" />
                  </g>

                  <g opacity="0.10">
                    <line x1="250" y1="250" x2="250" y2="80" stroke="#0C245C" stroke-width="2" />
                    <line x1="250" y1="250" x2="400" y2="180" stroke="#0C245C" stroke-width="2" />
                    <line x1="250" y1="250" x2="350" y2="380" stroke="#0C245C" stroke-width="2" />
                    <line x1="250" y1="250" x2="150" y2="380" stroke="#0C245C" stroke-width="2" />
                    <line x1="250" y1="250" x2="100" y2="180" stroke="#0C245C" stroke-width="2" />
                  </g>

                  <polygon
                    points="250,145 340,195 310,330 190,330 175,210"
                    fill="url(#dataGradient)"
                    stroke="#0C245C"
                    stroke-width="3"
                    filter="url(#glow)"
                  />

                  <g>
                    <circle cx="250" cy="145" r="7.5" fill="white" stroke="#0C245C" stroke-width="3">
                      <animate attributeName="r" values="7.5;9.5;7.5" dur="2.1s" begin="0s" repeatCount="indefinite" />
                    </circle>
                    <circle cx="340" cy="195" r="7.5" fill="white" stroke="#0C245C" stroke-width="3">
                      <animate attributeName="r" values="7.5;9.5;7.5" dur="2.1s" begin="0.15s" repeatCount="indefinite" />
                    </circle>
                    <circle cx="310" cy="330" r="7.5" fill="white" stroke="#0C245C" stroke-width="3">
                      <animate attributeName="r" values="7.5;9.5;7.5" dur="2.1s" begin="0.30s" repeatCount="indefinite" />
                    </circle>
                    <circle cx="190" cy="330" r="7.5" fill="white" stroke="#0C245C" stroke-width="3">
                      <animate attributeName="r" values="7.5;9.5;7.5" dur="2.1s" begin="0.45s" repeatCount="indefinite" />
                    </circle>
                    <circle cx="175" cy="210" r="7.5" fill="white" stroke="#0C245C" stroke-width="3">
                      <animate attributeName="r" values="7.5;9.5;7.5" dur="2.1s" begin="0.60s" repeatCount="indefinite" />
                    </circle>
                  </g>
                </svg>

                <!-- Labels (pills) -->
                <div class="absolute inset-0 pointer-events-none">
                  <div class="absolute -top-2 left-1/2 -translate-x-1/2 -translate-y-12">
                    <span class="label-pill">Procesos & Política</span>
                  </div>
                  <div class="absolute top-12 -right-4 translate-x-12">
                    <span class="label-pill">Ejecución</span>
                  </div>
                  <div class="absolute bottom-14 -right-1 translate-x-10">
                    <span class="label-pill">Planeación Táctica</span>
                  </div>
                  <div class="absolute bottom-14 -left-1 -translate-x-10">
                    <span class="label-pill">Planeación Operativa</span>
                  </div>
                  <div class="absolute top-12 -left-4 -translate-x-12">
                    <span class="label-pill">Operadores</span>
                  </div>
                  <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 translate-y-12">
                    <span class="label-pill">Tecnología</span>
                  </div>
                </div>
              </div>

              <div class="mt-6 flex items-center justify-between gap-3 text-xs text-slate-500">
                <p class="inline-flex items-center gap-2">
                  <span class="h-2 w-2 rounded-full bg-cyan-400"></span>
                  Visualización referencial
                </p>
                <p class="font-semibold text-[#0C245C]">Escala 1–5</p>
              </div>
            </div>
          </div>
        </div>
      </aside>

      <!-- Right: Accordion + bars -->
      <div class="lg:col-span-7">
        <div class="rounded-3xl border border-slate-200/70 bg-white shadow-xl shadow-[#0C245C]/5 overflow-hidden">
          <!-- Header -->
          <div class="px-7 py-6 bg-gradient-to-b from-[#0C245C]/5 to-white border-b border-slate-200/60">
            <div class="flex items-center justify-between gap-4">
              <div>
                <h3 class="text-lg sm:text-xl font-bold text-[#0C245C]">Principales elementos por dimensión</h3>
                <p class="mt-1 text-sm text-slate-500">Revisa el detalle y detecta rápidamente oportunidades.</p>
              </div>

              <div class="hidden sm:flex items-center gap-2">
                <span class="chip">Bajo</span>
                <span class="chip">Medio</span>
                <span class="chip">Alto</span>
              </div>
            </div>
          </div>

          <!-- Content -->
          <div class="p-3 sm:p-4">
            <div class="space-y-3">
              {sections.map((s) => (
                <details class="group rounded-2xl border border-slate-200/70 bg-white hover:shadow-md transition-shadow">
                  <summary class="cursor-pointer list-none px-4 sm:px-5 py-4">
                    <div class={`flex items-center gap-3 sm:gap-4 rounded-xl bg-gradient-to-r ${toneClasses[s.tone].header} px-3 py-3`}>
                      <span class={`grid place-items-center h-10 w-10 rounded-xl ${toneClasses[s.tone].icon} text-white shadow-sm`}>
                        <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[s.icon] ?? icons.doc}></svg>
                      </span>

                      <div class="min-w-0 flex-1">
                        <p class="text-base font-bold text-[#0C245C] truncate">{s.name}</p>
                        <p class="text-xs text-slate-500">Desglose de elementos y nivel estimado</p>
                      </div>

                      <span class={`shrink-0 rounded-full px-3 py-1 text-xs font-semibold ${toneClasses[s.tone].chip}`}>
                        {s.items.length} items
                      </span>

                      <span class="ml-2 shrink-0 grid place-items-center h-9 w-9 rounded-full bg-white ring-1 ring-slate-200 text-slate-500 group-open:rotate-180 transition-transform">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <path d="m6 9 6 6 6-6" />
                        </svg>
                      </span>
                    </div>
                  </summary>

                  <div class="px-4 sm:px-5 pb-5">
                    <div class="mt-1 rounded-2xl bg-slate-50/60 ring-1 ring-slate-200/60 p-4 sm:p-5">
                      <div class="space-y-4">
                        {s.items.map(([label, value]) => (
                          <div class="grid grid-cols-12 gap-3 items-center">
                            <div class="col-span-12 sm:col-span-5">
                              <p class="text-sm font-semibold text-[#0C245C] leading-tight">{label}</p>
                            </div>

                            <div class="col-span-12 sm:col-span-7">
                              <div class="h-9 rounded-full bg-white ring-1 ring-slate-200 overflow-hidden relative">
                                <div
                                  class={`h-full ${toneClasses[s.tone].bar} rounded-full flex items-center justify-end pr-3 bar-anim`}
                                  style={`width: ${value}%`}
                                >
                                  <span class="text-white text-xs font-bold tabular-nums">{value}%</span>
                                </div>

                                <div class="pointer-events-none absolute inset-0 opacity-0 group-open:opacity-100 transition-opacity">
                                  <div class="absolute inset-y-0 left-0 w-1/3 border-r border-slate-200/60"></div>
                                  <div class="absolute inset-y-0 left-1/3 w-1/3 border-r border-slate-200/60"></div>
                                </div>
                              </div>
                            </div>
                          </div>
                        ))}
                      </div>

                      <div class="mt-5 flex flex-wrap items-center gap-2 text-xs text-slate-500">
                        <span class={`font-semibold ${toneClasses[s.tone].accent}`}>Tip:</span>
                        <span>Enfócate primero en barras &lt; 40% para impacto rápido.</span>
                      </div>
                    </div>
                  </div>
                </details>
              ))}
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .label-pill{
    display:inline-flex;
    align-items:center;
    gap:.4rem;
    padding:.45rem .7rem;
    border-radius:9999px;
    background:rgba(255,255,255,.88);
    border:1px solid rgba(148,163,184,.45);
    box-shadow: 0 10px 30px rgba(12,36,92,.06);
    font-size:12px;
    font-weight:700;
    color:#0C245C;
    backdrop-filter: blur(10px);
    white-space:nowrap;
  }

  .chip{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:.35rem .65rem;
    border-radius:9999px;
    font-size:12px;
    font-weight:700;
    color:#0C245C;
    background:rgba(12,36,92,.06);
    border:1px solid rgba(12,36,92,.12);
  }

  summary::-webkit-details-marker{ display:none; }

  details[open] .bar-anim{
    animation: growBar .7s ease-out both;
    transform-origin:left;
  }
  @keyframes growBar{
    from{ transform:scaleX(.2); filter:saturate(.85); }
    to{ transform:scaleX(1); filter:saturate(1); }
  }
</style>
