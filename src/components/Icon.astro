---
type IconKey = "user" | "linkedin" | "mail" | "instagram" | "facebook";

type Props = {
  name?: IconKey;
  class?: string;
};

const { name = "user", class: className = "w-4 h-4" } = Astro.props as Props;
---

{ name === "user" && (
  <svg xmlns="http://www.w3.org/2000/svg" class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
    <path d="M20 21a8 8 0 1 0-16 0" />
    <circle cx="12" cy="8" r="4" />
  </svg>
)}

{ name === "linkedin" && (
  <svg xmlns="http://www.w3.org/2000/svg" class={className} viewBox="0 0 24 24" fill="currentColor">
    <path d="M4.98 3.5A2.5 2.5 0 1 0 5 8.5a2.5 2.5 0 0 0-.02-5ZM3 21h4V9H3v12Zm7 0h4v-6.5c0-1.7.3-3.3 2.4-3.3 2 0 2.1 1.9 2.1 3.4V21h4v-7.2c0-3.6-.8-6.3-5-6.3-2 0-3.4 1.1-4 2.1h-.1V9h-3.8v12Z" />
  </svg>
)}

{ name === "mail" && (
  <svg xmlns="http://www.w3.org/2000/svg" class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
    <path d="M4 6h16v12H4z" />
    <path d="m4 7 8 6 8-6" />
  </svg>
)}

{ name === "instagram" && (
  <svg xmlns="http://www.w3.org/2000/svg" class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
    <rect x="4" y="4" width="16" height="16" rx="4" />
    <circle cx="12" cy="12" r="3.5" />
    <path d="M17.5 6.5h.01" />
  </svg>
)}

{ name === "facebook" && (
  <svg xmlns="http://www.w3.org/2000/svg" class={className} viewBox="0 0 24 24" fill="currentColor">
    <path d="M13 22v-8h3l1-4h-4V7.5c0-1.1.3-1.8 1.9-1.8H17V2.1C16.6 2 15.4 2 14 2c-2.8 0-5 1.7-5 5v3H6v4h3v8h4Z" />
  </svg>
)}
