---
interface Props {
  title: string;
  desc: string;
  chips: string[];
  badge?: string;
  icon?: string;
  image: string;
  href: string;
  cta?: string;
  delay?: string;
  logo?: string;
  id?: string;
}

const {
  title,
  desc,
  chips = [],
  badge,
  icon,
  image,
  href,
  cta = "Agendar diagnóstico",
  delay = "0ms",
  logo = "/img/logo.png",
  id,
} = Astro.props;
---

<article
  class="st-reveal overflow-hidden rounded-[2rem] bg-white shadow-[0_20px_60px_rgba(12,36,92,0.12)]"
  style={`--d:${delay}`}
  id={id}
>
  <div class="grid md:grid-cols-[1.02fr_0.98fr]">
    <!-- Columna izquierda -->
    <div class="relative flex flex-col justify-between p-8 md:p-12 bg-[#f8f8f8]">
      <!-- Logo arriba izquierda -->
      <div class="mb-8">
        <img
          src={logo}
          alt="Logo de la empresa"
          class="h-20 w-auto object-contain"
          loading="lazy"
        />
      </div>

      <div>
        <div class="mb-6 flex items-center gap-6">
          <div class="flex h-[72px] w-[72px] items-center justify-center rounded-[1.2rem] bg-[#173b84] shadow-[0_12px_24px_rgba(23,59,132,0.18)]">
            <Fragment set:html={icon} />
          </div>

          <div>
            <h3 class="text-4xl md:text-5xl font-extrabold tracking-tight text-[#0C245C]">
              {title}
            </h3>
          </div>
        </div>

        <p class="max-w-2xl text-xl leading-relaxed text-slate-600">
          {desc}
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          {chips.map((chip) => (
            <span class="rounded-full border border-slate-200 bg-[#eef1f6] px-4 py-3 text-base font-semibold text-[#243f79]">
              {chip}
            </span>
          ))}
        </div>
      </div>

      <div class="mt-10">
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-[1.1rem] bg-[#102f78] px-7 py-4 text-lg font-bold text-white shadow-[0_18px_35px_rgba(16,47,120,0.22)] transition hover:-translate-y-0.5"
        >
          {cta} <span class="ml-2">›</span>
        </a>
      </div>
    </div>

    <!-- Columna derecha -->
    <div class="relative min-h-[420px] overflow-hidden bg-sky-500">
      <img
        src={image}
        alt={title}
        class="absolute inset-0 h-full w-full object-cover"
        loading="lazy"
      />

      <div class="absolute inset-0 bg-gradient-to-t from-[#0C245C]/10 via-transparent to-transparent"></div>

      <div class="absolute left-6 top-6">
        <div class="inline-flex items-center gap-3 rounded-full bg-white/80 px-4 py-3 backdrop-blur-md">
          <span class="h-3 w-3 rounded-full bg-[#173b84]"></span>
          <span class="text-sm font-semibold text-[#173b84]">Servicio</span>
          {badge && (
            <span class="rounded-full bg-[#d8e6f4] px-4 py-1.5 text-sm font-semibold text-[#173b84]">
              {badge}
            </span>
          )}
        </div>
      </div>
    </div>
  </div>
</article>